import pickle

# 1D array (list)
arr = [10, 20, 30, 40, 50]

# Writing array to a binary file
with open("array.bin", "wb") as f:
    pickle.dump(arr, f)

print("Array saved to array.bin")

# Reading array back from binary file
with open("array.bin", "rb") as f:
    loaded_arr = pickle.load(f)

print("Loaded array:", loaded_arr)
